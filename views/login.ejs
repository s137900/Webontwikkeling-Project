<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="../css/login_register.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="../js/login_register.js" defer></script>
</head>
<body>
    
    <div class="login_screen">
        <input autocomplete="off" placeholder="Username" type="text" name="" id="username" required>
        <input autocomplete="off" placeholder="Password" type="text" name="" id="password" required>
        <div class="button_div">
            <button onclick="login()">Login</button>
            <a href="/register">Register?</a>
        </div>
    </div>
</body>
</html>